# Slack
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL_ID=C0123456789

# Emoji name used to mark processed threads (without colons)
SEEN_EMOJI=eyes

# Whether to reply in-thread with a link to the created ticket
POST_REPLY=true

# Google Cloud (Claude via Vertex AI)
# Authenticate with: gcloud auth application-default login
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-east5
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: second Slack channel for insights/demos/learnings
# INSIGHTS_CHANNEL_ID=C9876543210

# Linear
LINEAR_API_KEY=lin_api_your-key-here
LINEAR_TEAM_ID=your-team-uuid-here
# LINEAR_PROJECT_ID=your-project-uuid-here
# LINEAR_LABEL_IDS=uuid1,uuid2
# LINEAR_ASSIGNEE_ID=assignee-uuid-here
# LINEAR_STATE_ID=state-uuid-here
# LINEAR_DOCUMENT_ID=doc-uuid-here
